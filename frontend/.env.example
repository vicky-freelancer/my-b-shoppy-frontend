# Optional frontend env vars (read only at Vite dev time).

# Backend URL for Razorpay order creation + verification.
# Dev: LEAVE UNSET so /api calls go through the Vite proxy to localhost:5000.
# Prod: set to your deployed backend, e.g. VITE_API_URL="https://api.mybshoppy.com"
# VITE_API_URL="https://api.mybshoppy.com"

# Override the backend the Vite dev proxy forwards /api calls to.
# Default: http://localhost:5000 (the Express server in ../backend)
# RAZORPAY_SERVER_URL="http://localhost:5000"

# Set to "true" to disable HMR + file watching (used in sandboxed/AI Studio runtimes).
# DISABLE_HMR="true"
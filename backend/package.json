{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Express API for my B shoppy (Razorpay orders, payment verification, webhooks). Serves the built frontend in production.",
  "scripts": {
    "test": "node --test src/server.test.mjs src/payment-security.test.mjs src/checkout-control.test.mjs src/commerce/*.test.mjs",
    "start": "node src/server.mjs",
    "server": "node src/server.mjs",
    "dev": "node --watch src/server.mjs",
    "lint": "node --check src/server.mjs",
    "test:mariadb": "node --test src/commerce/*.test.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "mariadb": "^3.5.4",
    "multer": "^2.5.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.28.2"
  }
}

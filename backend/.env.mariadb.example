# TEMPLATE ONLY. Do not copy real credentials into source control.
# Hostinger MariaDB connection for the storefront catalog API.
# On Hostinger, the database host is normally 127.0.0.1 from the Node app.
MARIADB_ENABLED=true
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_DATABASE=u839831098_mybshoppyDB
MARIADB_USER=u839831098_adminmybshoppy
MARIADB_PASSWORD=

# Absolute, writable directory for uploaded product images. It must survive
# redeployments; do not point it at the release directory.
MEDIA_DIRECTORY=

# Checkout remains disabled until the payment backend is activated.
CHECKOUT_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_ID=

# Optional isolated test profile only.
DEPLOYMENT_PROFILE=
NODE_ENV=production
PORT=3000
TEST_ALLOWED_ORIGINS=
